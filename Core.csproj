<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    </PropertyGroup>

  <PropertyGroup>
    <PackageId>Qimono.Baza.Modeloj</PackageId>
    <Version>1.0.0</Version>                           
    <Title>Baza Modeloj (by QiMono)</Title>
    <Authors>QiMono</Authors>
    <Description>Basic Domain for .NET Apps</Description> 
    <!-- <PackageLicenseExpression>LGPL-3.0</PackageLicenseExpression> -->
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile> 
    <PackageProjectUrl>https://qimono76.wordpress.com</PackageProjectUrl> 
    <RepositoryUrl>https://github.com/qimono-repos/modeloj-baza.git</RepositoryUrl> 
    <RepositoryType>git</RepositoryType>             
    <PackageTags>domain;models;ddd</PackageTags> 
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild> 
  </PropertyGroup>


  <ItemGroup Condition="'$(IsBlazorWasm)' != 'true'">
    <PackageReference Include="HotChocolate.AspNetCore" Version="15.0.3" />
    <PackageReference Include="HotChocolate.Data" Version="15.0.3" />
  </ItemGroup>
  <ItemGroup>
      <None Include="LICENSE.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
